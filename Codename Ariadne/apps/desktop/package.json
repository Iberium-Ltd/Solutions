    "@testing-library/user-event": "14.6.1",
    "@types/cytoscape": "3.31.0",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "29.1.1",
    "oxlint": "1.71.0",
    "typescript": "6.0.2",
    "vite": "8.1.1",
    "vitest": "4.1.10"
  }
