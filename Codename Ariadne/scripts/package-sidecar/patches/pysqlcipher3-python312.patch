+/* Ariadne extension: apply a 256-bit raw SQLCipher key from any object that
+ * exposes the buffer protocol. This avoids Python bytes/hex/string copies. */
+static PyObject *
+pysqlite_connection_set_raw_key(pysqlite_Connection* self, PyObject* args)
+{
+    Py_buffer key = {0};
+    const char* database_name = NULL;
+    int rc;
+
+    if (!pysqlite_check_thread(self) || !pysqlite_check_connection(self)) {
+        return NULL;
+    }
+
+    if (!PyArg_ParseTuple(args, "y*|s:set_raw_key", &key, &database_name)) {
+        return NULL;
+    }
+    if (key.len != 32) {
+        PyBuffer_Release(&key);
+        PyErr_SetString(PyExc_ValueError, "raw key must contain exactly 32 bytes");
+        return NULL;
+    }
+
+    if (database_name == NULL) {
+        rc = sqlite3_key(self->db, key.buf, (int)key.len);
+    } else {
+        rc = sqlite3_key_v2(self->db, database_name, key.buf, (int)key.len);
+    }
+    PyBuffer_Release(&key);
+
+    if (rc != SQLITE_OK) {
+        PyErr_SetString(self->DatabaseError, sqlite3_errmsg(self->db));
+        return NULL;
+    }
+
+    Py_RETURN_NONE;
+}
