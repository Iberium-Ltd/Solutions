# Generated UI review artifacts (the written review remains tracked).
/artifacts/
/playwright-report/
/test-results/
/coverage/

# Tooling and builds.
node_modules/
dist/
build/
target/
.turbo/
.vite/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated, inspected native sidecar staged only for a local Tauri release build.
/apps/desktop/src-tauri/binaries/ariadne-core-*

# Editors and operating-system metadata.
.DS_Store
**/.DS_Store
.idea/
*.swp
