/.privacy/
**/.private-denylist*
**/*.quarantine

# Runtime personal data and secrets.
/.env
/.env.*
!/.env.example
**/.env
**/.env.*
!**/.env.example
/data/
/evidence/
/imports/private/
/exports/private/
/reports/private/
/models/local/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
